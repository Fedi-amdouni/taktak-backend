# Required in production; use the pooled PostgreSQL connection string from your DB host.
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/taktak_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=replace-me

# Comma-separated exact frontend origins; do not use * with credentials enabled.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Render/Railway-style hosts provide PORT automatically. Local default remains 8081.
PORT=8081
